<Project Sdk="Microsoft.NET.Sdk">

  <!-- The packaging scripts' archiver: tar.gz and zip with explicit Unix modes, so the Linux
       package built on Windows extracts with working apphosts. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SloppyAnimatsu.Core\SloppyAnimatsu.Core.csproj" />
  </ItemGroup>

</Project>
