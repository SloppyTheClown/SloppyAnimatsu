<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SloppyAnimatsu.Core\SloppyAnimatsu.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Server GC (adaptive since .NET 9): loading a large scene collects on all cores, about
         twice as fast with the same peak memory. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests run a CLI verb end to end (BlendshapeSessionTests.CliBlendshapeAdd...). -->
    <InternalsVisibleTo Include="SloppyAnimatsu.Tests" />
  </ItemGroup>

</Project>
